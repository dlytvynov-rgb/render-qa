{
  "name": "render-qa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "proxy": "node proxy.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "npm run build && electron electron/main.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.renderqa.app",
    "productName": "Render QA",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "node_modules/**", "package.json"],
    "win": { "target": "portable", "forceCodeSigning": false },
    "portable": { "artifactName": "RenderQA.exe" },
    "mac": { "target": "dmg", "forceCodeSigning": false, "artifactName": "RenderQA.dmg" }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
